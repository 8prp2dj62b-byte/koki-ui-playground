{
  "name": "koki-chatgpt-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "KOKI interactive ChatGPT frontend, OAuth gateway and MCP server",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit && tsc -p tsconfig.server.json",
    "start": "node server-dist/gateway.js",
    "dev:server": "tsx src/gateway.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.4",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
